# dotfiles-MacBook/zsh/zprofile  →  ~/.config/zsh/.zprofile
# ──────────────────────────────────────────────────────────────────────────────
# Login-shell env (macOS). Terminal/iTerm/ghostty start login shells, so this
# runs once per session and is the right place for PATH-shaping env: Homebrew,
# language toolchains, and the 1Password SSH-agent socket.
# ──────────────────────────────────────────────────────────────────────────────
# Homebrew — Apple Silicon first, then Intel. `brew shellenv` output is static for a
# given prefix, so cache it and `source` the cache (one read) instead of forking brew
# on every login shell — which matters because the `exec tmux` below starts a login
# shell per pane. Regenerate only when the brew binary is newer than the cache. This
# is a zprofile-local cache (Core's _cache_eval isn't loaded yet at login-shell time).
# The cache filename is keyed on the brew PREFIX (homebrew/local), so a box that has
# (or switches to) the other brew never sources the wrong prefix's env. On the regen
# path we source ONLY freshly-written content: if the write fails (unwritable dir, full
# disk) we fall back to a live eval rather than sourcing a stale cache — so PATH is never
# lost and never stale.
() {
  local brew
  for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [[ -x "$brew" ]] || continue
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/brew-shellenv-${brew:h:h:t}.zsh"
    if [[ -s "$cache" && ! "$brew" -nt "$cache" ]]; then
      source "$cache"                                      # fresh cache → no brew fork
    # Generate from a PATH that does NOT lead with brew: `shellenv` opens with an
    # idempotence guard and prints NOTHING when its own bin:sbin already lead PATH. In a
    # nested login shell (a tmux pane below) that would cache an EMPTY file, which `-s`
    # then rejects on every later login — re-forking brew forever, the one cost this
    # cache exists to avoid. A sanitised PATH makes the output unconditionally complete,
    # which keeps `-s` meaningful as a "the write succeeded" test.
    elif { mkdir -p "${cache:h}" && PATH=/usr/bin:/bin "$brew" shellenv >| "$cache"; } 2>/dev/null; then
      source "$cache"                                      # regenerated → source fresh write
    else
      eval "$("$brew" shellenv)"                           # uncacheable → live eval (never stale)
    fi
    break
  done
}

# juliaup-managed Julia (if installed). `typeset -U path` (.zshenv) dedups the prepend.
[[ -d "$HOME/.juliaup/bin" ]] && path=("$HOME/.juliaup/bin" $path)

# Where this repo lives — DERIVED from this file's own resolved path, never hardcoded.
# %x is the sourced path (~/.config/zsh/.zprofile), :A follows the bootstrap symlink back
# to <repo>/zsh/zprofile, and :h:h climbs to the repo root.
#
# This used to read "$HOME/dotfiles-MacBook". The clone location is the operator's choice,
# and a real checkout of this repo lives at ~/code/dotgibson/dotfiles-MacBook — so the
# literal pointed at a directory that does not exist, and mise silently trusted nothing.
# os/macos.zsh sets the same var with `:=` for non-login shells; whichever runs first wins.
: "${DOTFILES_MACBOOK_ROOT:=${${(%):-%x}:A:h:h}}"
export DOTFILES_MACBOOK_ROOT

# mise: trust THIS machine's dotfiles dir for project mise configs. This lives in the OS
# layer on purpose — the trusted path is machine-specific (the Core config.toml ships a
# portable default and must stay byte-identical to upstream so `git subtree pull` never
# conflicts). MISE_TRUSTED_CONFIG_PATHS is mise's env override (colon-separated); set here
# rather than edited into the vendored core/mise/config.toml.
export MISE_TRUSTED_CONFIG_PATHS="$DOTFILES_MACBOOK_ROOT${MISE_TRUSTED_CONFIG_PATHS:+:$MISE_TRUSTED_CONFIG_PATHS}"

# 1Password SSH agent (macOS). `ssh`/`git` use keys held in 1Password. Guarded on
# the socket actually existing, so this self-disables (and ssh falls back to the
# default agent) when 1Password isn't installed/running — pointing SSH_AUTH_SOCK at
# a missing socket otherwise breaks ssh-add and every agent operation. Comment out
# the whole block if you don't use the 1Password agent.
_op_ssh_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
[[ -S "$_op_ssh_sock" ]] && export SSH_AUTH_SOCK="$_op_ssh_sock"
unset _op_ssh_sock
