#!/usr/bin/env bash
# ================================================================================================
# JankyBorders (FelixKratz) — the colored ring around the focused window, so the active tile is
# unmistakable. This file IS the config: started bare (which is how `brew services` starts it),
# `borders` looks for ~/.config/borders/bordersrc and executes it on launch. Symlinked there by
# bootstrap.sh; installed via the Brewfile.
#
# It lives here rather than on aerospace.toml's after-startup-command line because launchd owns
# the lifecycle now (`brew services start borders` — keep_alive, starts at login, survives an
# AeroSpace restart), and a brew service runs the binary with NO arguments. AeroSpace still
# launches a bare `borders` as a fallback; either way the options below are what it comes up with.
#
# Palette is tokyonight-storm, matched to sketchybar/colors.sh: blue accent (#7aa2f7) when
# focused, comment-grey (#565f89) when not. The GlazeWM twin is its native window_effects border
# (same two colors) — change both together.
# ================================================================================================

borders \
  active_color=0xff7aa2f7 \
  inactive_color=0xff565f89 \
  width=5.0 \
  order=above
