# Theme
theme = TokyoNight Storm
background-opacity = 0.75
background-blur = 20
# frosted glass behind the 0.75 translucency (macOS); numeric = blur radius,
# matched to sketchybar's blur_radius=20 so terminal + bar share the same glass.
macos-window-buttons = hidden
macos-titlebar-style = hidden

# Font
font-family = 'CaskaydiaCove Nerd Font'
font-size = 16
font-thicken = true
# Programming ligatures. Ghostty expects OpenType feature TAGS (unquoted, one per
# line, repeatable) — not `"+ligatures"`, which is not a real tag and was silently
# ignored, so ligatures fell back to default behavior. `calt` (contextual
# alternates) drives CaskaydiaCove's -> => != etc.; `liga` enables standard ligatures.
font-feature = calt
font-feature = liga

# Cursor — bar caret (softer than block). Revert with `cursor-style = block`.
cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true

# Ambient shader — animated starfield behind the terminal (opt-in eye-candy).
# COST: continuous GPU draw → measurable battery use on a laptop. To turn it off,
# comment the two lines below and reload (cmd+shift+, ). The shader lives in the
# repo at ghostty/shaders/space.glsl, linked into ~/.config/ghostty/shaders.
custom-shader = ~/.config/ghostty/shaders/space.glsl
custom-shader-animation = true

# Window
window-save-state = always
confirm-close-surface = false
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
# absorb leftover space evenly (padding-x/y are asymmetric)
# Breathing room so text doesn't kiss the window edge. Middle of the range floated
# in the mockups (polish 10x8 · refresh 14x10 · bold 22x16) — bump for more air.
# Dim inactive splits so focus lands on the active pane.
unfocused-split-opacity = 0.85
# Keyboard / macOS
# Without this, macOS emits Unicode glyphs (Ω ≈ …) on Option instead of Alt — which
# silently breaks every Alt binding downstream: zsh Alt+Z (zoxide jump), tmux Alt+H/L
# (windows) and Alt+arrows (panes). `true` = both Options act as Alt; use `left` to
# keep right-Option free for typing accented characters.
macos-option-as-alt = true
# Shell integration: defaults already enable cursor/title/path; this adds `sudo` so
# password prompts behave correctly. (cursor/title/path stay on — the flag merges.)
shell-integration-features = sudo

# Quick terminal + key passthrough
keybind = alt+space=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.2
keybind = ctrl+enter=text:\x1b[13;5u
keybind = shift+enter=text:\x1b[13;2u

# Discoverability: command palette (fuzzy-search every action + its keybind)
keybind = cmd+shift+p=toggle_command_palette
